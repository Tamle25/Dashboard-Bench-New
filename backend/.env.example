# Sao chép thành backend/.env rồi chỉnh.
BENCH_DATA_DIR=./data
# Để trống = SQLite ở data/bench.db
BENCH_DATABASE_URL=
# Bắt buộc nếu dùng webhook GitHub/GitLab
BENCH_WEBHOOK_SECRET=
# Chỉ bật khi phát triển: cho phép nguồn bench là thư mục trên máy
BENCH_ALLOW_LOCAL_SOURCES=true
BENCH_CORS_ORIGINS=["http://localhost:5173"]
BENCH_MODEL_TIMEOUT_S=60

# API key của mô hình: đặt tên biến ở màn "Mô hình" (ô "Tên bí mật"), giá trị đặt ở đây
# MODEL_X_API_KEY=sk-...

# Agent Harbor (codex, claude-code…): tên bí mật tuỳ ý, backend sẽ truyền
# --api-key-name cho Harbor. Dùng đúng tên mặc định thì khỏi phải khai gì thêm.
# OPENAI_API_KEY=sk-...          # agent codex
# ANTHROPIC_API_KEY=sk-ant-...   # agent claude-code

# ForkCode (agent CLI dạng fork của opencode, binary đóng): màn Mô hình, kiểu "Agent Harbor",
# agent forkcode_agent:ForkcodeAgent, model <provider>/<model> (thêm #low/#medium/#high để chọn variant).
# Cần đăng nhập agent trên chính máy này: mỗi trial adapter đọc DB đã đăng nhập và secret trong
# Windows Credential Manager. Xem đầy đủ trong backend/harbor_plugins/forkcode_agent.py.
# BENCH_HARBOR_PASS_ENV=["FORKCODE_*"]
# FORKCODE_BRAND=forkcode                                   # tên nội bộ của bản fork (thư mục dữ liệu, keyring)
# FORKCODE_BINARY=D:/path/to/linux-x64/agent                # binary cho Linux x64 (bắt buộc)
# FORKCODE_VARIANT=high
# FORKCODE_WORKDIR=/app                                     # mặc định: WORKDIR của image task
